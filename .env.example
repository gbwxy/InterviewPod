# ================================
# InterviewPod 环境变量配置模板
# ================================
# 使用方式：
#   开发环境：cp .env.example .env.dev，然后填入实际值
#   生产环境：cp .env.example .env，然后填入实际值
# ================================

# ================================
# 1. 数据库配置 (PostgreSQL)
# ================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interviewpod
POSTGRES_USER=postgres
# 生产环境请使用强密码
POSTGRES_PASSWORD=password

# ================================
# 2. Redis 配置
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
# 如需密码认证，取消下行注释
# REDIS_PASSWORD=

# ================================
# 3. MinIO 对象存储配置
# ================================
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interviewpod
APP_STORAGE_REGION=us-east-1

# ================================
# 4. 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
# ================================
AI_BAILIAN_API_KEY=your_dashscope_api_key_here
# 默认 AI 模型
AI_MODEL=qwen3.5-flash

# Provider API Key 加密密钥（必填；生产环境请替换为随机长字符串，部署后保持不变）
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# ================================
# 5. 其他 AI Provider 配置（可选）
# ================================

# LM Studio 本地 Provider
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 自定义 OpenAI 兼容 Provider:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 6. JWT 认证配置
# ================================
# JWT 签名密钥（必填；生产环境请替换为随机长字符串，至少 32 字符）
JWT_SECRET=change_me_jwt_secret_key_at_least_32_chars
# Access Token 过期时间（毫秒），默认 2 小时
JWT_ACCESS_EXPIRATION_MS=7200000
# Refresh Token 过期时间（毫秒），默认 7 天
JWT_REFRESH_EXPIRATION_MS=604800000

# ================================
# 7. 短信服务配置（阿里云 SMS）
# ================================
# 是否开启 Mock 模式（开发环境可设为 true，不发送真实短信）
SMS_MOCK=true
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=InterviewPod
SMS_TEMPLATE_CODE=

# ================================
# 8. 微信支付配置
# ================================
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_APP_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=

# ================================
# 9. 支付宝配置
# ================================
# 是否使用沙箱环境（开发/测试设为 true）
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# ================================
# 10. 预置用户种子配置
# ================================
# 应用启动时自动创建/补齐的预置用户（JSON 数组）。
# 仅当用户不存在或密码为空时才会写入，不会覆盖已有密码。
# APP_PRESET_USERS_JSON=[{"username":"admin","password":"admin","role":"ADMIN"},{"username":"test1","password":"testTest001","role":"LITE"}]

# ================================
# 11. 面试参数配置（可选）
# ================================
# 语音面试：多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000

# 面试追问次数
# APP_INTERVIEW_FOLLOW_UP_COUNT=1
# 面试评估批量大小
# APP_INTERVIEW_EVALUATION_BATCH_SIZE=8

# ================================
# 12. CORS 与安全配置
# ================================
CORS_ALLOWED_ORIGINS=https://your-domain.com
